# ---------------------------------------------------------------------------
# CruziaPay - exemplo de variáveis de ambiente
# Copie para .env e preencha. Em produção use o cofre de secrets do projeto.
# ---------------------------------------------------------------------------

# Chave da API do SendGrid usada para enviar os leads do formulário de contato
# para comercial@cruziapay.com.br. Gere em https://app.sendgrid.com/settings/api_keys
# com permissão "Mail Send". Formato: SG.xxxxxxxx
SENDGRID_API_KEY=

# Endereço remetente verificado no SendGrid (Single Sender ou domínio autenticado).
# Opcional: se vazio, usa no-reply@cruziapay.com.br
SENDGRID_FROM_EMAIL=no-reply@cruziapay.com.br

# URL do webhook do Google Apps Script (implantado como "Web app", acesso "Anyone").
# Recebe o lead em JSON e grava uma linha na planilha.
# Formato: https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SHEET_WEBHOOK=

# Backend (Lovable Cloud / Supabase) - preenchidos automaticamente
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=